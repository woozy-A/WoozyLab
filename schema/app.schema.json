{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woozy-A.github.io/WoozyLab/schema/app.schema.json",
  "title": "WoozyLab App",
  "description": "WoozyLab 앱 소개, 지원, 개인정보 페이지에 사용하는 기준 데이터입니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "slug",
    "name",
    "status",
    "platform",
    "tagline",
    "summary",
    "appStoreURL",
    "supportEmail",
    "marketingURL",
    "supportURL",
    "privacyURL",
    "permissions",
    "privacyFacts",
    "features",
    "screenshots",
    "accentColor",
    "icon",
    "privacyPolicyUpdatedAt",
    "updatedAt",
    "sourceFiles",
    "todos"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schema/app.schema.json"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "status": {
      "description": "현재 공개 페이지에서 확인한 상태 문구입니다. 확정할 수 없으면 null을 사용합니다.",
      "$ref": "#/$defs/nullableNonEmptyString"
    },
    "platform": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "tagline": {
      "$ref": "#/$defs/nullableNonEmptyString"
    },
    "summary": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "appStoreURL": {
      "$ref": "#/$defs/nullableAppStoreURL"
    },
    "supportEmail": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    "marketingURL": {
      "$ref": "#/$defs/httpsURL"
    },
    "supportURL": {
      "$ref": "#/$defs/httpsURL"
    },
    "privacyURL": {
      "$ref": "#/$defs/httpsURL"
    },
    "permissions": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permission"
          }
        }
      ]
    },
    "privacyFacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screenshot"
      }
    },
    "accentColor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      ]
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "pattern": "^assets/(?!\\.\\.?(?:/|$))(?!.*(?:/\\.\\.?)(?:/|$))[^\\s]+\\.(?:png|jpe?g|webp|svg)$"
    },
    "privacyPolicyUpdatedAt": {
      "$ref": "#/$defs/nullableDate"
    },
    "updatedAt": {
      "$ref": "#/$defs/date"
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "todos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullableNonEmptyString": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/nonEmptyString"
        }
      ]
    },
    "httpsURL": {
      "type": "string",
      "minLength": 9,
      "pattern": "^https://[^\\s]+$"
    },
    "nullableHttpsURL": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/httpsURL"
        }
      ]
    },
    "nullableAppStoreURL": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^https://apps\\.apple\\.com/[^\\s]+$"
        }
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "nullableDate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/date"
        }
      ]
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "required"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "alt"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^assets/(?!\\.\\.?(?:/|$))(?!.*(?:/\\.\\.?)(?:/|$))[^\\s]+\\.(?:png|jpe?g|webp|svg)$"
        },
        "alt": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
